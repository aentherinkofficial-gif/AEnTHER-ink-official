rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /portfolio/{category}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email == "aentherinkofficial@gmail.com"
        && request.resource.size < 30 * 1024 * 1024;
    }
  }
}
